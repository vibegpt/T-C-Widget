{
  "openapi": "3.0.3",
  "info": {
    "title": "PolicyCheck API",
    "version": "2.1.0",
    "description": "Independent seller policy facts with source excerpts and signed provenance. The calling agent makes purchase decisions."
  },
  "servers": [
    {
      "url": "https://policycheck.tools"
    }
  ],
  "paths": {
    "/api/check": {
      "post": {
        "operationId": "checkPolicies",
        "summary": "Extract signed seller policy facts",
        "description": "No scores or purchase verdicts. Missing facts do not mean false. Inspect status, provenance and limitations.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "seller_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Discover common seller policy paths"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Fetch exactly this policy page"
                  },
                  "policy_text": {
                    "type": "string",
                    "minLength": 50,
                    "maxLength": 100000
                  },
                  "text": {
                    "type": "string",
                    "minLength": 50,
                    "maxLength": 100000,
                    "description": "Alias for policy_text"
                  },
                  "agent_id": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "transaction_ref": {
                    "type": "string",
                    "maxLength": 256
                  }
                },
                "anyOf": [
                  {
                    "required": [
                      "seller_url"
                    ]
                  },
                  {
                    "required": [
                      "url"
                    ]
                  },
                  {
                    "required": [
                      "policy_text"
                    ]
                  },
                  {
                    "required": [
                      "text"
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed result; may disclose incomplete or failed extraction",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Analysis"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "503": {
            "description": "Analysis or signing unavailable"
          }
        }
      }
    },
