    "/api/v1/verify": {
      "post": {
        "operationId": "verifyAssessment",
        "summary": "Verify signature and freshness separately",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "signed_assessment",
                  "signature"
                ],
                "properties": {
                  "signed_assessment": {
                    "type": "object"
                  },
                  "signature": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validity result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "valid": {
                      "type": "boolean"
                    },
                    "signature_valid": {
                      "type": "boolean"
                    },
                    "fresh": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid verification request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Analysis": {
        "type": "object",
        "required": [
          "analysis_status",
          "policies",
          "sources",
          "limitations",
          "signed_assessment",
          "signature"
        ],
        "properties": {
          "analysis_status": {
            "type": "string",
            "enum": [
              "complete",
              "partial",
              "text_provided",
              "no_content",
              "no_facts",
              "extraction_failed"
            ]
          },
          "policies": {
            "type": "object",
            "additionalProperties": true
          },
          "clauses": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "coverage": {
            "type": "object"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "signed_assessment": {
            "type": "object",
            "description": "Exact signed v2.1 payload binding facts, provenance, timestamps, context and limitations"
          },
          "signature": {
            "type": "string",
            "description": "Ed25519 signature, base64url"
          },
          "audit_recorded": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
